# Daedalus — environment (owner secrets). Copy to $DAEDALUS_HOME/.env (0600) or
# let scripts/setup.sh write it. Never commit a real .env.

# Owner identity — only this user may talk to the agent.
DISCORD_ALLOWED_USERS=
DISCORD_BOT_TOKEN=

# Model providers (heavy chain)
NVIDIA_API_KEY=
ZAI_API_KEY=
